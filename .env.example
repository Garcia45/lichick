# ============================================================
# KONFIGURASI LICHICK (VERCEL ENVIRONMENT VARIABLES)
# Salin file ini menjadi .env.local untuk testing lokal,
# lalu masukkan nilai yang sama di Settings -> Environment Variables Vercel.
# ============================================================

# 1. Google Apps Script Web App URL (akhiran /exec) dari google-sheets-script.gs
GOOGLE_SHEETS_WEBHOOK_URL=

# 2. Link Google Sheets (opsional, untuk tombol "Buka Google Sheets" di Panel Admin)
NEXT_PUBLIC_GOOGLE_SHEETS_URL=

# 3. Secret opsional (harus sama dengan API_SECRET di google-sheets-script.gs jika diisi)
GOOGLE_SHEETS_API_SECRET=

# 4. Path rahasia Panel Admin (akses lewat /portal/<ADMIN_SECRET_SLUG>, /admin otomatis 404)
ADMIN_SECRET_SLUG=dapur-lucuih-26

# 5. Password / PIN login Panel Admin (isi PIN atau password bebas)
ADMIN_PIN=123456

# 6. Secret penanda cookie sesi Admin (isi teks acak panjang)
ADMIN_SESSION_SECRET=lichick-ganti-dengan-secret-acak-panjang-2026

# 7. Nomor WhatsApp Admin penerima pesanan (Format 628..., sesuai poster: 082190437013)
NEXT_PUBLIC_ADMIN_WHATSAPP=6282190437013
